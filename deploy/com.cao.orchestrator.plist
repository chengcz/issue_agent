<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.cao.orchestrator</string>
  <key>ProgramArguments</key><array>
    <string>/opt/coding-agent-orchestrator/.venv/bin/cao</string>
    <string>--config</string><string>/opt/coding-agent-orchestrator/orchestrator.toml</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key><string>/opt/coding-agent-orchestrator</string>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/opt/coding-agent-orchestrator/logs/stdout.log</string>
  <key>StandardErrorPath</key><string>/opt/coding-agent-orchestrator/logs/stderr.log</string>
</dict></plist>

