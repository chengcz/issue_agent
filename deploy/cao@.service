[Unit]
Description=Coding Agent Orchestrator (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/opt/coding-agent-orchestrator
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/cao/environment
EnvironmentFile=-/etc/cao/%i.env
ExecStart=/opt/coding-agent-orchestrator/.venv/bin/cao --config /etc/cao/%i.toml serve
Restart=always
RestartSec=10
TimeoutStopSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/cao /var/lib/cao -/home/agent/.cache -/home/agent/.config -/home/agent/.codex
UMask=0077

[Install]
WantedBy=multi-user.target
