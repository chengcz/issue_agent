[Unit]
Description=Coding Agent Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/opt/coding-agent-orchestrator
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/autocode/environment
ExecStart=/opt/coding-agent-orchestrator/.venv/bin/autocode --config /etc/autocode/autocode.toml serve
Restart=always
RestartSec=10
TimeoutStopSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/agent-dev /var/lib/autocode -/home/agent/.cache -/home/agent/.config -/home/agent/.codex
UMask=0077

[Install]
WantedBy=multi-user.target
